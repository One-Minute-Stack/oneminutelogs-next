{
  "name": "@oneminutelogs/next",
  "version": "2.0.2",
  "description": "A Lightweight npm package for working with one minute logs. Set up your logging pipeline within one minute.",
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.cts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run clean && tsup",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:dashboard-browser": "npm run build && node test/dashboard-browser.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/One-Minute-Stack/oneminutelogs-next.git"
  },
  "keywords": [
    "logs",
    "one-minute-stack",
    "structured-logging",
    "monitoring",
    "observability",
    "audit",
    "security"
  ],
  "author": "OneMinute Stack",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/One-Minute-Stack/oneminutelogs-next/issues"
  },
  "homepage": "https://oneminutelogs.com/docs/nextjs",
  "peerDependencies": {
    "react": ">=18",
    "@oneminutelogs/browser": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "react": "^19.2.7",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "@oneminutelogs/browser": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "./admin": {
      "types": "./dist/admin.d.cts",
      "default": "./dist/admin.cjs"
    },
    "./package.json": "./package.json",
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "import": "./dist/dashboard.js",
      "default": "./dist/dashboard.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ]
}
